# Backend Environment Variables
PORT=your_backend_port
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/<dbname>?appName=<app-name>
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1d
NODE_ENV=development

#Kafka Configuration
AFKA_BROKERS=your_kafka_url:kafka_port
KAFKA_CLIENT_ID=your_kafka_clientId
KAFKA_GROUP_ID=your_kafka_grpupId

#OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/auth/github/callback
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_CALLBACK_URL=http://localhost:5000/auth/linkedin/callback
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_CALLBACK_URL=http://localhost:5000/auth/discord/callback
